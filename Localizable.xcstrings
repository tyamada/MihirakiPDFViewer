    "The generated PDF could not be read.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Die erzeugte PDF-Datei konnte nicht gelesen werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "No se ha podido leer el PDF generado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire le PDF généré."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "生成したPDFを読み取れませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "생성된 PDF를 읽을 수 없습니다."
          }
        }
      }
    },
    "The privacy policy is available from Settings and App Information without opening a PDF or making a purchase.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Die Datenschutzerklärung ist über Einstellungen und App-Informationen verfügbar, ohne eine PDF zu öffnen oder einen Kauf zu tätigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Puedes consultar la política de privacidad desde Ajustes e Información de la app sin abrir un PDF ni realizar una compra."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Maaari mong tingnan ang patakaran sa privacy mula sa Mga Setting at Impormasyon ng App nang hindi nagbubukas ng PDF o bumibili."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "La politique de confidentialité est accessible depuis Réglages et Informations sur l’app sans ouvrir de PDF ni effectuer d’achat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Kebijakan privasi dapat diakses dari Pengaturan dan Informasi App tanpa membuka PDF atau melakukan pembelian."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "PDFを開いたり購入したりしなくても、設定とアプリ情報からプライバシーポリシーを確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "PDF를 열거나 구매하지 않아도 설정 및 앱 정보에서 개인정보 처리방침을 확인할 수 있습니다."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "PDF नखोली वा खरिद नगरी पनि सेटिङहरू र एप जानकारीबाट गोपनीयता नीति हेर्न सकिन्छ।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "A política de privacidade está disponível em Ajustes e Informações do app sem abrir um PDF ou fazer uma compra."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Bạn có thể xem chính sách quyền riêng tư từ Cài đặt và Thông tin ứng dụng mà không cần mở PDF hoặc mua hàng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "无需打开 PDF 或进行购买，即可从设置和应用信息查看隐私政策。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "無須開啟PDF或進行購買，即可從「設定」和「App資訊」查看隱私權政策。"
          }
        }
      }
    },
