        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "기기 모델명과 모델 식별자, 앱 정보, 메모리, 캐시 저장 공간, 사용 가능한 저장 공간 및 PDF 렌더링을 확인합니다. 결과는 사용자가 ‘공유’를 탭한 경우에만 공유됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Verifica o nome e o identificador do modelo do dispositivo, informações do app, memória, armazenamento em cache, espaço disponível e renderização de PDF. Os resultados são compartilhados somente quando você toca em Compartilhar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kiểm tra tên và mã định danh kiểu máy, thông tin ứng dụng, bộ nhớ, bộ nhớ đệm, dung lượng lưu trữ khả dụng và khả năng hiển thị PDF. Kết quả chỉ được chia sẻ khi bạn chạm vào Chia sẻ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "检查设备型号名称和型号标识符、应用信息、内存、缓存存储、可用存储空间及 PDF 渲染。仅当你轻点“共享”时才会共享结果。"
