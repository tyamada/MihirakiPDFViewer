          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Comprueba el nombre y el identificador del modelo del dispositivo, la información de la app, la memoria, el almacenamiento en caché, el espacio disponible y el renderizado de PDF. Los resultados solo se comparten cuando tocas Compartir."
