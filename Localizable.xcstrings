        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La réinitialisation rétablira l’icône d’app par défaut. Pour réutiliser une icône de soutien, vous devrez effectuer un nouvel achat de soutien."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mengatur ulang akan mengembalikan ikon app default. Untuk menggunakan ikon pendukung lagi, Anda harus melakukan pembelian dukungan lagi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リセットすると、アプリアイコンは標準に戻ります。サポーターアイコンを再び使用するには、もう一度応援購入が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "재설정하면 기본 앱 아이콘으로 돌아갑니다. 후원자 아이콘을 다시 사용하려면 후원 구매를 다시 해야 합니다."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "रिसेट गर्दा पूर्वनिर्धारित एप आइकन पुनर्स्थापित हुनेछ। समर्थक आइकन फेरि प्रयोग गर्न, तपाईंले अर्को सहयोग खरिद गर्नुपर्नेछ।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A redefinição restaurará o ícone padrão do app. Para usar novamente um ícone de apoiador, você precisará fazer outra compra de apoio."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu bạn đã thay đổi biểu tượng ứng dụng, biểu tượng đó sẽ không thể được khôi phục sau khi đặt lại!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
