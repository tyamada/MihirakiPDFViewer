    },
    "help_setting_scroll_direction_description": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Legt fest, ob die Seiten von links nach rechts oder von rechts nach links weitergeblättert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Selects whether pages advance from left to right or right to left."
          }
        },
        "es": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Selecciona si las páginas avanzan de izquierda a derecha o de derecha a izquierda."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Pinipili kung uusad ang mga pahina mula kaliwa pakanan o kanan pakaliwa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Sélectionne le sens de défilement des pages, de gauche à droite ou de droite à gauche."
          }
        },
        "id": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Memilih apakah halaman bergerak dari kiri ke kanan atau dari kanan ke kiri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "ページを左から右へ送るか、右から左へ送るかを選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "페이지를 왼쪽에서 오른쪽 또는 오른쪽에서 왼쪽으로 넘길지 선택합니다."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "पृष्ठहरू बायाँबाट दायाँ वा दायाँबाट बायाँ कुन दिशामा अगाडि बढ्ने भन्ने चयन गर्छ।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Seleciona se as páginas avançam da esquerda para a direita ou da direita para a esquerda."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Chọn thứ tự chuyển trang từ trái sang phải hoặc từ phải sang trái."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "选择页面是从左向右还是从右向左翻页。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "選擇頁面要由左至右或由右至左翻頁。"
          }
        }
      }
    },
    "help_setting_sharpness_description": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Passt an, wie stark Text und Linien geschärft werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Adjusts how strongly text and lines are sharpened."
          }
        },
        "es": {
          "stringUnit": {
