    "promotion_code_instructions": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Gültige Codes für Bronze, Silver und Gold können im Bildschirm „Unterstützen“ eingelöst werden. Neue Angebote für das Koyomi-Abzeichen werden auf später verschoben. Bestehende Abzeichenkäufe können wiederhergestellt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Eligible Bronze, Silver, and Gold codes can be redeemed from Support. New Koyomi badge offers are deferred. Existing badge purchases can be restored."
          }
        },
        "es": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Los códigos válidos de Bronze, Silver y Gold se pueden canjear desde Apoyo. La nueva oferta de la insignia Koyomi se pospone. Las compras anteriores de insignias se pueden restaurar."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Maaaring i-redeem sa Suporta ang mga kwalipikadong code para sa Bronze, Silver, at Gold. Ipinagpapaliban ang bagong pag-aalok ng Koyomi badge. Maaaring i-restore ang mga badge na dati nang binili."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les codes admissibles Bronze, Silver et Gold peuvent être utilisés depuis l’écran Soutenir. Les nouvelles offres du badge Koyomi sont reportées. Les achats existants de badges peuvent être restaurés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Kode Bronze, Silver, dan Gold yang memenuhi syarat dapat ditukarkan dari Dukungan. Penawaran baru lencana Koyomi ditunda. Pembelian lencana yang sudah ada dapat dipulihkan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Bronze・Silver・Goldの対象コードは応援画面で引き換えられます。リリース記念こよみバッジの新規提供は後日に見送ります。取得済みのバッジは購入の復元で戻せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "후원 화면에서 사용 가능한 Bronze, Silver, Gold 코드를 교환할 수 있습니다. 코요미 배지의 신규 제공은 추후로 미룹니다. 기존 배지 구매 항목은 복원할 수 있습니다."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "सहयोग स्क्रिनबाट योग्य Bronze, Silver र Gold कोड प्रयोग गर्न सकिन्छ। Koyomi ब्याजको नयाँ उपलब्धता पछि सारिएको छ। पहिले खरिद गरिएका ब्याजहरू पुनर्स्थापना गर्न सकिन्छ।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Os códigos elegíveis Bronze, Silver e Gold podem ser resgatados na tela Apoiar. Novas ofertas do selo Koyomi foram adiadas. As compras existentes de selos podem ser restauradas."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Bạn có thể đổi mã Bronze, Silver và Gold đủ điều kiện từ màn hình Ủng hộ. Việc cung cấp mới huy hiệu Koyomi được hoãn lại. Có thể khôi phục các giao dịch mua huy hiệu hiện có."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "可在支持页面兑换符合条件的Bronze、Silver和Gold代码。Koyomi徽章的新提供将推迟，已有徽章购买项目可恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "可在支持畫面兌換符合條件的Bronze、Silver和Gold代碼。Koyomi徽章的新提供將延後，既有徽章購買項目可回復。"
          }
        }
      }
    },
