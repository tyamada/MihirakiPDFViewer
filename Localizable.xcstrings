    "Logs are stored only on this device and are never sent externally automatically. Sharing occurs only when you tap Share." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Protokolle werden nur auf diesem Gerät gespeichert und niemals automatisch extern gesendet. Sie werden nur geteilt, wenn du auf „Teilen“ tippst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Los registros se almacenan únicamente en este dispositivo y nunca se envían automáticamente al exterior. Solo se comparten cuando tocas Compartir."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sa device na ito lamang sine-save ang mga log at hindi kailanman awtomatikong ipinapadala sa labas. Ibinabahagi lamang ang mga ito kapag i-tap mo ang Ibahagi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les journaux sont stockés uniquement sur cet appareil et ne sont jamais envoyés automatiquement à l’extérieur. Ils ne sont partagés que lorsque vous touchez Partager."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ログはこの端末内にのみ保存され、外部へ自動的に送信されることはありません。“共有”をタップした場合にのみ共有されます。"
          }
        }
      }
    },
    "Logs never include personal information, file names, file paths, search terms, passwords, or document contents." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Protokolle enthalten niemals persönliche Informationen, Dateinamen, Dateipfade, Suchbegriffe, Passwörter oder Dokumentinhalte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Los registros nunca incluyen información personal, nombres de archivo, rutas de archivo, términos de búsqueda, contraseñas ni contenido de documentos."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hindi kailanman kasama sa mga log ang personal na impormasyon, mga pangalan ng file, mga path ng file, mga termino sa paghahanap, mga password, o nilalaman ng dokumento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les journaux ne contiennent jamais d’informations personnelles, de noms de fichiers, de chemins d’accès, de termes de recherche, de mots de passe ni de contenu de documents."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ログには個人情報、ファイル名、ファイルパス、検索語、パスワード、または文書の内容は記録されません。"
          }
        }
      }
    },
    "Logs older than 24 hours are deleted automatically." : {
      "localizations" : {
