        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "화면의 세로 길이가 가로보다 길 때 한 번에 한 페이지를 표시합니다."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "स्क्रिनको उचाइ चौडाइभन्दा बढी हुँदा, यन्त्रको प्रकार जेसुकै भए पनि, पूर्वनिर्धारित रूपमा एक पटकमा एउटा पृष्ठ देखाउँछ। पोर्ट्रेटमा दुई-पृष्ठ दृश्य कायम राख्न यसलाई बन्द गर्नुहोस्।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Exibe uma página por vez quando a tela está mais alta do que larga."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hiển thị mỗi lần một trang khi chiều cao màn hình lớn hơn chiều rộng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "当屏幕高度大于宽度时，每次显示一页。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "當螢幕高度大於寬度時，一次顯示一頁。"
          }
        }
      }
    },
