    "developer_support_description" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Unterstützung hilft, die App aktuell zu halten. Du kannst alle Funktionen nutzen, ohne etwas zu kaufen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your support helps keep the app updated. You can use all features without making a purchase."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu apoyo ayuda a mantener la app actualizada. Puedes usar todas las funciones sin realizar una compra."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ang suporta mo ay nakatutulong para mapanatiling napapanahon ang app. Magagamit mo ang lahat ng feature nang hindi bumibili."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre soutien aide à maintenir l’app à jour. Vous pouvez utiliser toutes les fonctionnalités sans effectuer d’achat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dukungan Anda membantu menjaga app tetap diperbarui. Anda dapat menggunakan semua fitur tanpa melakukan pembelian."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "応援していただくことで、アプリの更新を継続できます。購入しなくてもすべての機能を利用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여러분의 지원은 앱을 계속 업데이트하는 데 도움이 됩니다. 구매하지 않아도 모든 기능을 사용할 수 있습니다."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "तपाईंको सहयोगले एपलाई अद्यावधिक राख्न मद्दत गर्छ। खरिद नगरी पनि तपाईं सबै सुविधाहरू प्रयोग गर्न सक्नुहुन्छ।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu apoio ajuda a manter o app atualizado. Você pode usar todos os recursos sem fazer uma compra."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sự ủng hộ của bạn giúp ứng dụng luôn được cập nhật. Bạn có thể sử dụng mọi tính năng mà không cần mua hàng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的支持有助于保持应用更新。无需购买也可以使用所有功能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "你的支持有助於持續更新App。即使不購買，也能使用所有功能。"
          }
        }
      }
