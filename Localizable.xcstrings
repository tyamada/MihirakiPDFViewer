    "A GitHub account is required. The information you submit may be publicly visible.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Ein GitHub-Account ist erforderlich. Die übermittelten Informationen sind möglicherweise öffentlich sichtbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Se requiere una cuenta de GitHub. La información que envíes puede ser visible públicamente."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Kailangan ng GitHub account. Maaaring makita ng publiko ang impormasyong isusumite mo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Un compte GitHub est requis. Les informations que vous envoyez peuvent être visibles publiquement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "GitHubアカウントが必要です。送信した情報は一般公開される場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "GitHub 계정이 필요합니다. 제출한 정보는 공개될 수 있습니다."
          }
        }
      }
    },
    "A screenshot, app logs, or device test results when helpful": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Screenshots werden nur per privater E-Mail an tyamada.support@gmail.com angenommen, wenn sich das Problem mit Text allein nicht reproduzieren lässt und ein Bild erforderlich ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Screenshots are accepted only by private email at tyamada.support@gmail.com when text alone cannot reproduce the problem and an image is needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Solo se aceptan capturas de pantalla por correo privado en tyamada.support@gmail.com cuando el texto por sí solo no permite reproducir el problema y se necesita una imagen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Tumatanggap lang ng mga screenshot sa pribadong email na tyamada.support@gmail.com kapag hindi sapat ang teksto para maulit ang problema at kailangan ng larawan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Les captures d’écran sont acceptées uniquement par e-mail privé à tyamada.support@gmail.com, lorsque le texte seul ne permet pas de reproduire le problème et qu’une image est nécessaire."
          }
        },
        "id": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Tangkapan layar hanya diterima melalui email pribadi di tyamada.support@gmail.com jika teks saja tidak cukup untuk mereproduksi masalah dan gambar diperlukan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "スクリーンショットは、文章だけでは問題を再現できず、画像が必要な場合に限り、非公開のメール窓口tyamada.support@gmail.comで受け付けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "스크린샷은 글만으로 문제를 재현할 수 없고 이미지가 필요한 경우에만 비공개 이메일 tyamada.support@gmail.com으로 받습니다."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "लेखेर मात्र समस्या पुनः उत्पन्न गर्न नसकिने र चित्र आवश्यक पर्ने अवस्थामा मात्र tyamada.support@gmail.com मा निजी इमेलबाट स्क्रिनसट स्वीकार गरिन्छ।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Capturas de tela são aceitas apenas por e-mail privado em tyamada.support@gmail.com quando o texto por si só não permite reproduzir o problema e uma imagem é necessária."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Ảnh chụp màn hình chỉ được tiếp nhận qua email riêng tư tại tyamada.support@gmail.com khi không thể tái hiện vấn đề chỉ bằng văn bản và cần có hình ảnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "仅在单靠文字无法重现问题且确实需要图片时，才通过非公开电子邮件 tyamada.support@gmail.com 接收截屏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "只有在單靠文字無法重現問題且需要圖片時，才透過非公開電子郵件tyamada.support@gmail.com接收螢幕截圖。"
          }
        }
      }
    },
    "A short summary of the problem": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Eine kurze Zusammenfassung des Problems"
