    "help_setting_supporter_icons_description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Öffnet den Unterstützer-Store, um Unterstützersymbole und -abzeichen zu kaufen oder wiederherzustellen."
