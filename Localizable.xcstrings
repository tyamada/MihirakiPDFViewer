    "app_icon_change_failed": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das App-Symbol konnte nicht geändert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not change the app icon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cambiar el icono de la app."
          }
        },
