    "help_setting_device_testing_description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Prüft Modellname und Modellkennung des Geräts, App-Informationen, Arbeitsspeicher, Cache-Speicher, verfügbaren Speicherplatz und die PDF-Darstellung. Ergebnisse werden nur geteilt, wenn du auf „Teilen“ tippst."
