    "help_diagnostic_privacy_description": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Wähle aus, an wen und ob du senden möchtest. Prüfe den Text und hinzugefügte Bilder. Supportnachrichten können deinem Fall zugeordnet werden. Durch das Teilen werden sie nicht anonym."
          }
        },
        "en": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Choose the recipient and whether to send. Review the text and any added images. Support messages may be linked to your case; sharing does not make them anonymous."
          }
        },
        "es": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Elige el destinatario y si quieres enviar la información. Revisa el texto y las imágenes añadidas. Los mensajes de soporte pueden vincularse a tu caso; compartirlos no los convierte en anónimos."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Piliin ang tatanggap at kung ipapadala. Suriin ang teksto at anumang idinagdag na larawan. Maaaring iugnay ang mga mensahe sa suporta sa iyong kaso; hindi nagiging anonymous ang mga ito dahil sa pagbabahagi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Choisissez le destinataire et décidez si vous souhaitez envoyer les informations. Vérifiez le texte et les images ajoutées. Les messages au support peuvent être associés à votre dossier. Le partage ne les rend pas anonymes."
          }
        },
        "id": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Pilih penerima dan tentukan apakah akan mengirim. Periksa teks serta gambar yang ditambahkan. Pesan dukungan dapat dikaitkan dengan kasus Anda; membagikannya tidak menjadikannya anonim."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "宛先と送信するかどうかを選択してください。本文と追加した画像を確認してください。問い合わせ内容は案件と関連付けられる場合があり、共有によって匿名になるわけではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "받는 사람과 전송 여부를 선택하십시오. 본문과 추가한 이미지를 확인하십시오. 지원 문의는 해당 문의 건과 연결될 수 있으며, 공유한다고 해서 익명으로 처리되지는 않습니다."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "प्राप्तकर्ता र पठाउने वा नपठाउने भन्ने छान्नुहोस्। पाठ र थपिएका तस्बिरहरू जाँच गर्नुहोस्। सहायता सन्देशहरू तपाईंको मामिलासँग जोडिन सक्छन्; साझा गर्दा ती बेनामी हुँदैनन्।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Escolha o destinatário e se deseja enviar. Revise o texto e as imagens adicionadas. As mensagens de suporte podem ser vinculadas ao seu caso; compartilhá-las não as torna anônimas."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Hãy chọn người nhận và quyết định có gửi hay không. Kiểm tra văn bản và hình ảnh đã thêm. Tin nhắn hỗ trợ có thể được liên kết với yêu cầu của bạn; việc chia sẻ không làm chúng trở nên ẩn danh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "请选择收件人并决定是否发送。检查正文和添加的图片。支持消息可能会关联到你的问题个案，分享并不会使其匿名。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "請選擇收件人並決定是否傳送。檢查文字和加入的圖片。支援訊息可能會與你的案件建立關聯，分享不代表匿名。"
          }
        }
      }
    },
    "help_diagnostic_report_problem_description": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Öffne in der Hilfe „Problem melden“, um dieselben Hinweise zur Meldung aufzurufen. Beschreibe das Problem zuerst schriftlich und nutze öffentliche GitHub Issues oder private E-Mails. Screenshots werden nur per privater E-Mail angenommen, wenn Text nicht ausreicht. Dein echter Name ist nicht erforderlich. Prüfe vor dem Senden Diagnosedaten, Protokolle und die Empfängeradresse."
          }
        },
        "en": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Open Report a Problem from Help for the same reporting instructions. Start with text; use public GitHub Issues or private email. Screenshots are accepted only by private email when text is insufficient. Your real name is not required. Review diagnostics, logs, and the recipient before sending."
          }
        },
        "es": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Abre “Informar de un problema” desde la ayuda para consultar las mismas instrucciones. Empieza con una descripción por escrito y usa GitHub Issues para informes públicos o el correo para consultas privadas. Solo se aceptan capturas de pantalla por correo privado cuando el texto no es suficiente. No es necesario indicar tu nombre real. Revisa los diagnósticos, los registros y el destinatario antes de enviar."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Buksan ang Mag-ulat ng Problema mula sa Tulong para sa parehong mga tagubilin sa pag-uulat. Unahin ang teksto; gamitin ang pampublikong GitHub Issues o pribadong email. Tumatanggap lang ng mga screenshot sa pribadong email kapag hindi sapat ang teksto. Hindi kailangan ang tunay mong pangalan. Suriin ang diagnostics, mga log, at ang tatanggap bago ipadala."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Ouvrez « Signaler un problème » depuis l’aide pour retrouver les mêmes instructions. Commencez par une description écrite, puis utilisez les signalements publics GitHub Issues ou un e-mail privé. Les captures d’écran sont acceptées uniquement par e-mail privé lorsque le texte ne suffit pas. Votre nom réel n’est pas nécessaire. Vérifiez les diagnostics, les journaux et le destinataire avant l’envoi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Buka Laporkan Masalah dari Bantuan untuk petunjuk pelaporan yang sama. Mulailah dengan teks; gunakan GitHub Issues yang bersifat publik atau email pribadi. Tangkapan layar hanya diterima melalui email pribadi jika teks tidak mencukupi. Nama asli Anda tidak diperlukan. Tinjau diagnostik, log, dan penerima sebelum mengirim."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "ヘルプから“問題を報告”を開くと、同じ報告手順を確認できます。まず文章で説明し、公開のGitHub Issuesまたは非公開のメール窓口を利用してください。スクリーンショットは文章では不十分な場合に限り、非公開のメールで受け付けます。実名の記入は不要です。送信前に診断結果、ログ、宛先を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "도움말에서 문제 보고를 열면 동일한 보고 안내를 볼 수 있습니다. 먼저 글로 설명하고 공개 GitHub Issues 또는 비공개 이메일을 이용하세요. 스크린샷은 글로 설명하기 부족한 경우에만 비공개 이메일로 받습니다. 실명은 필요하지 않습니다. 보내기 전에 진단 결과, 로그 및 받는 사람을 확인하세요."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "उही रिपोर्ट गर्ने निर्देशनहरू हेर्न मद्दतबाट समस्या रिपोर्ट गर्नुहोस् खोल्नुहोस्। पहिले लेखेर वर्णन गर्नुहोस्; सार्वजनिक GitHub Issues वा निजी इमेल प्रयोग गर्नुहोस्। लिखित विवरण पर्याप्त नभएमा मात्र निजी इमेलबाट स्क्रिनसट स्वीकार गरिन्छ। आफ्नो वास्तविक नाम दिनु पर्दैन। पठाउनुअघि निदान, लग र प्राप्तकर्ता जाँच्नुहोस्।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Abra Relatar um Problema na Ajuda para ver as mesmas instruções. Comece com texto; use o GitHub Issues público ou o e-mail privado. Capturas de tela são aceitas apenas por e-mail privado quando o texto não é suficiente. Não é necessário informar seu nome real. Revise os diagnósticos, os registros e o destinatário antes de enviar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Hãy mở Báo cáo sự cố từ Trợ giúp để xem cùng hướng dẫn báo cáo. Bắt đầu bằng văn bản; sử dụng GitHub Issues công khai hoặc email riêng tư. Ảnh chụp màn hình chỉ được tiếp nhận qua email riêng tư khi văn bản không đủ. Bạn không cần cung cấp tên thật. Hãy kiểm tra dữ liệu chẩn đoán, nhật ký và người nhận trước khi gửi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "从帮助打开“报告问题”，即可查看相同的报告说明。请先用文字说明，再选择公开的 GitHub Issues 或非公开电子邮件。仅在文字说明不足时，才通过非公开电子邮件接收截屏。无需填写真实姓名。发送前请核对诊断结果、日志和收件人。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "從輔助說明開啟「回報問題」，即可查看相同的回報指引。請先用文字說明，再使用公開的GitHub Issues或非公開電子郵件。只有文字說明不足時，才透過非公開電子郵件接收螢幕截圖。不必填寫真實姓名。寄送前請確認診斷結果、記錄和收件者。"
          }
        }
      }
    },
    "help_diagnostics_description": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Verwende die Diagnosewerkzeuge auf dem Gerät und prüfe die Datenschutzinformationen, bevor Ergebnisse geteilt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Use on-device diagnostic tools and review privacy information before sharing results."
          }
        },
        "es": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Usa las herramientas de diagnóstico del dispositivo y revisa la información sobre privacidad antes de compartir los resultados."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Gamitin ang mga diagnostic tool sa device at suriin ang impormasyon tungkol sa privacy bago ibahagi ang mga resulta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Utilisez les outils de diagnostic de l’appareil et consultez les informations sur la confidentialité avant de partager les résultats."
          }
        },
        "id": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Gunakan alat diagnostik di perangkat dan tinjau informasi privasi sebelum membagikan hasil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "端末内の診断ツールを使用し、結果を共有する前にプライバシー情報を確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "기기 내 진단 도구를 사용하고 결과를 공유하기 전에 개인정보 보호 정보를 확인합니다."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "यन्त्रमा रहेका निदान उपकरणहरू प्रयोग गर्नुहोस् र परिणामहरू साझा गर्नुअघि गोपनीयतासम्बन्धी जानकारी जाँच गर्नुहोस्।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Use as ferramentas de diagnóstico no dispositivo e consulte as informações de privacidade antes de compartilhar os resultados."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Sử dụng các công cụ chẩn đoán trên thiết bị và xem lại thông tin về quyền riêng tư trước khi chia sẻ kết quả."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "使用设备上的诊断工具，并在共享结果前查看隐私信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "使用裝置上的診斷工具，並在分享結果前查看隱私權資訊。"
          }
        }
      }
    },
    "help_layout_description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende die Layoutoptionen im Menü, um zwischen Einzel- und Doppelseitenansicht zu wechseln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the layout options in the menu to switch between single-page and two-page views."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa las opciones de diseño del menú para cambiar entre la vista de una página y la vista de dos páginas."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Gamitin ang mga opsyon sa layout sa menu para magpalipat-lipat sa view na isang pahina at view na dalawang pahina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez les options de mise en page du menu pour passer de l’affichage une page à deux pages."
          }
        },
        "id": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Gunakan opsi tata letak di menu untuk beralih antara tampilan satu halaman dan dua halaman."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニュー内のレイアウトオプションを使って、単ページ表示と見開き表示を切り替えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴의 레이아웃 옵션을 사용해 단일 페이지 보기와 두 페이지 보기 사이를 전환합니다."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "एकल-पृष्ठ र दुई-पृष्ठ दृश्यहरू बीच स्विच गर्न मेनुमा रहेका लेआउट विकल्पहरू प्रयोग गर्नुहोस्।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use as opções de layout no menu para alternar entre a visualização de página única e de duas páginas."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Sử dụng các tùy chọn bố cục trong menu để chuyển đổi giữa chế độ xem một trang và hai trang."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用菜单中的布局选项，在单页视图和双页视图之间切换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "使用選單中的佈局選項，在單頁顯示與雙頁顯示之間切換。"
          }
        }
      }
