    "help_zoom_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe zwei Finger zusammen oder auseinander, um zu zoomen. Halte gedrückt und ziehe, um im vergrößerten Zustand zu scrollen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinch to zoom in or out. Long-press and drag to scroll while zoomed in."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pellizca para acercar o alejar. Mantén pulsado y arrastra para desplazarte mientras está ampliado."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kurutin ang screen para mag-zoom in o mag-zoom out. Pindutin nang matagal at i-drag para mag-scroll habang naka-zoom in."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pincez pour zoomer ou dézoomer. Appuyez longuement puis faites glisser pour faire défiler en mode zoom."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cubit untuk memperbesar atau memperkecil. Tekan lama dan seret untuk menggulir saat tampilan diperbesar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ピンチ操作で拡大または縮小します。拡大中は長押ししてからドラッグするとスクロールできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "핀치하여 확대하거나 축소합니다. 확대 중에는 길게 누른 뒤 드래그하여 스크롤합니다."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "जुम इन वा आउट गर्न पिन्च गर्नुहोस्। जुम इन गरिएको बेला स्क्रोल गर्न लामो समय थिचेर तान्नुहोस्।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use o gesto de pinça para ampliar ou reduzir. Mantenha pressionado e arraste para rolar enquanto estiver ampliado."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chụm hai ngón tay để phóng to hoặc thu nhỏ. Nhấn giữ và kéo để cuộn khi đang phóng to."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过捏合手势放大或缩小。放大时长按并拖动即可滚动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "使用撥動手勢放大或縮小。放大時，請長按並拖移來捲動。"
          }
        }
      }
    },
