    "reset_app_icon_warning": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Beim Zurücksetzen wird das standardmäßige App-Symbol wiederhergestellt. Um ein Unterstützer-Symbol erneut zu verwenden, muss die App erneut durch einen Kauf unterstützt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Resetting will restore the default app icon. To use a supporter icon again, you’ll need to make another support purchase."
          }
        },
        "es": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Al restablecer los ajustes, se recuperará el icono predeterminado de la app. Para volver a usar un icono de colaborador, tendrás que realizar otra compra de apoyo."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Ibabalik ng pag-reset ang default na icon ng app. Para magamit muli ang supporter icon, kailangan mong bumili ulit ng suporta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "La réinitialisation rétablira l’icône d’app par défaut. Pour réutiliser une icône de soutien, vous devrez effectuer un nouvel achat de soutien."
          }
        },
        "id": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Mengatur ulang akan mengembalikan ikon app default. Untuk menggunakan ikon pendukung lagi, Anda harus melakukan pembelian dukungan lagi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リセットすると、アプリアイコンは標準に戻ります。サポーターアイコンを再び使用するには、もう一度応援購入が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "재설정하면 기본 앱 아이콘으로 돌아갑니다. 후원자 아이콘을 다시 사용하려면 후원 구매를 다시 해야 합니다."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "रिसेट गर्दा पूर्वनिर्धारित एप आइकन पुनर्स्थापित हुनेछ। समर्थक आइकन फेरि प्रयोग गर्न, तपाईंले अर्को सहयोग खरिद गर्नुपर्नेछ।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "A redefinição restaurará o ícone padrão do app. Para usar novamente um ícone de apoiador, você precisará fazer outra compra de apoio."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu bạn đã thay đổi biểu tượng ứng dụng, biểu tượng đó sẽ không thể được khôi phục sau khi đặt lại!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你更改了应用图标，重置后将无法恢复！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "重設會將App圖像恢復為預設圖像。若要再次使用支持者App圖像，你需要再次進行支持購買。"
          }
        }
      }
    },
    "reset_confirmation_message": {
      "extractionState": "stale",
      "localizations": {
        "de": {
