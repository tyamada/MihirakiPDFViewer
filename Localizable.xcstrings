          }
        }
      }
    },
    "Available storage is shown only on this device and is excluded from shared diagnostic results.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Der verfügbare Speicherplatz wird nur auf diesem Gerät angezeigt und ist nicht in geteilten Diagnoseergebnissen enthalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "El almacenamiento disponible solo se muestra en este dispositivo y no se incluye en los resultados de diagnóstico compartidos."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Ipinapakita lamang sa device na ito ang available na storage at hindi ito kasama sa mga ibinabahaging resulta ng diagnostic."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "L’espace de stockage disponible s’affiche uniquement sur cet appareil et n’est pas inclus dans les résultats de diagnostic partagés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Penyimpanan yang tersedia hanya ditampilkan di perangkat ini dan tidak disertakan dalam hasil diagnostik yang dibagikan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "空きストレージ容量はこの端末上にのみ表示され、共有する診断結果には含まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "사용 가능한 저장 공간은 이 기기에만 표시되며 공유되는 진단 결과에는 포함되지 않습니다."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "उपलब्ध भण्डारण यस यन्त्रमा मात्र देखाइन्छ र साझा गरिने निदान परिणामहरूमा समावेश हुँदैन।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "O armazenamento disponível é mostrado apenas neste dispositivo e não é incluído nos resultados de diagnóstico compartilhados."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Dung lượng lưu trữ khả dụng chỉ được hiển thị trên thiết bị này và không được đưa vào kết quả chẩn đoán được chia sẻ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "可用存储空间仅在此设备上显示，不包含在共享的诊断结果中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "可用儲存空間僅顯示於此裝置上，不會包含在分享的診斷結果中。"
          }
        }
      }
    },
