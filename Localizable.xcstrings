            "state": "machine_translated",
            "value": "すべてのテストに合格しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "모든 테스트를 통과했습니다."
          }
        }
      }
    },
    "alternate_app_icons_not_supported": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternative App-Symbole werden in dieser Umgebung nicht unterstützt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternate app icons are not supported in this environment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los iconos alternativos de la app no son compatibles en este entorno."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Hindi sinusuportahan sa environment na ito ang mga alternatibong icon ng app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les icônes alternatives de l’app ne sont pas prises en charge dans cet environnement."
          }
        },
        "id": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Ikon app alternatif tidak didukung di lingkungan ini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この環境では代替アプリアイコンはサポートされていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 환경에서는 대체 앱 아이콘이 지원되지 않습니다."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "यो वातावरणमा वैकल्पिक एप आइकनहरू समर्थित छैनन्।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ícones alternativos do app não são compatíveis neste ambiente."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Biểu tượng ứng dụng thay thế không được hỗ trợ trong môi trường này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此环境不支持备用应用图标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "此環境不支援替代App圖像。"
          }
        }
      }
    },
