    "help_diagnostic_privacy_description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Diagnoseergebnisse und Protokolle bleiben auf diesem Gerät, sofern sie nicht ausdrücklich geteilt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Diagnostic results and logs remain on this device unless you explicitly share them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Los resultados de diagnóstico y los registros permanecen en este dispositivo salvo que los compartas explícitamente."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nananatili sa device na ito ang mga resulta ng diagnostic at log maliban kung tahasan mong ibahagi ang mga ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les résultats de diagnostic et les journaux restent sur cet appareil, sauf si vous les partagez explicitement."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "診断結果とログは、明示的に共有しない限り、この端末内にのみ保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "진단 결과와 로그는 사용자가 명시적으로 공유하지 않는 한 이 기기에만 보관됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Os resultados do diagnóstico e os registros permanecem neste dispositivo, a menos que você os compartilhe explicitamente."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kết quả chẩn đoán và nhật ký vẫn được lưu trên thiết bị này trừ khi bạn chủ động chia sẻ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "除非你明确选择共享，否则诊断结果和日志只会保留在此设备上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "除非你明確選擇分享，否則診斷結果和記錄只會保留在此裝置上。"
          }
        }
      }
    },
    "help_diagnostic_report_problem_description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Erläutert, welche Informationen ein Bericht enthalten sollte, enthält Links zu Gerätetests und App-Protokollen und öffnet nach einem Datenschutzhinweis GitHub Issues."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Explains what to include in a report, links to device tests and app logs, and opens GitHub Issues after a privacy reminder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Explica qué incluir en un informe, enlaza con las pruebas del dispositivo y los registros de la app, y abre GitHub Issues después de mostrar un recordatorio sobre privacidad."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ipinapaliwanag kung ano ang isasama sa ulat, nagbibigay ng mga link sa mga test ng device at log ng app, at binubuksan ang GitHub Issues pagkatapos ng paalala tungkol sa privacy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Explique les informations à inclure dans un rapport, fournit des liens vers les tests de l’appareil et les journaux de l’app, puis ouvre GitHub Issues après un rappel concernant la confidentialité."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "報告に含める内容を案内し、実機テストとアプリのログへのリンクを表示します。プライバシーに関する注意事項を確認したあと、GitHub Issuesを開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "문제 보고에 포함할 내용을 안내하고 기기 테스트 및 앱 로그 링크를 제공하며, 개인정보 보호 안내 후 GitHub Issues를 엽니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Explica o que incluir em um relato, fornece links para os testes do dispositivo e os registros do app e abre o GitHub Issues após um lembrete de privacidade."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Giải thích nội dung cần đưa vào báo cáo, cung cấp liên kết đến kiểm tra thiết bị và nhật ký ứng dụng, đồng thời mở GitHub Issues sau khi nhắc nhở về quyền riêng tư."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "说明报告中应包含的内容，提供设备测试和应用日志的链接，并在显示隐私提醒后打开 GitHub Issues。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "說明問題報告應包含的內容，提供裝置測試和App記錄的連結，並在顯示隱私權提醒後開啟GitHub Issues。"
          }
        }
      }
    },
    "help_diagnostics_description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Verwende die Diagnosewerkzeuge auf dem Gerät und prüfe die Datenschutzinformationen, bevor Ergebnisse geteilt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Use on-device diagnostic tools and review privacy information before sharing results."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Usa las herramientas de diagnóstico del dispositivo y revisa la información sobre privacidad antes de compartir los resultados."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gamitin ang mga diagnostic tool sa device at suriin ang impormasyon tungkol sa privacy bago ibahagi ang mga resulta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Utilisez les outils de diagnostic de l’appareil et consultez les informations sur la confidentialité avant de partager les résultats."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "端末内の診断ツールを使用し、結果を共有する前にプライバシー情報を確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
