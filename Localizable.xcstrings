    "developer_support_description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Unterstützung trägt dazu bei, dass die App weiterhin Updates erhält. Sie können alle Funktionen nutzen, ohne einen Kauf zu tätigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your support helps ensure the app continues to receive updates. You can use all features without making a purchase."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu apoyo ayuda a garantizar que la aplicación siga recibiendo actualizaciones. Puedes utilizar todas las funciones sin realizar ninguna compra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre soutien permet de garantir que l'application continue de recevoir des mises à jour. Vous pouvez utiliser toutes les fonctionnalités sans effectuer d'achat."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの応援が、アプリの継続的なアップデートに繋がります。購入しなくてもすべての機能を使用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여러분의 후원은 앱이 지속적으로 업데이트되는 데 큰 힘이 됩니다. 구매하지 않으셔도 모든 기능을 이용하실 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu apoio ajuda a garantir que o aplicativo continue recebendo atualizações. Você pode usar todos os recursos sem fazer nenhuma compra."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的支持有助于确保该应用持续获得更新。您无需付费即可使用所有功能。"
          }
        }
      }
    },
