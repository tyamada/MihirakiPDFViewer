    "developer_support_description" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Unterstützung hilft, die App aktuell zu halten. Du kannst alle Funktionen nutzen, ohne etwas zu kaufen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your support helps keep the app updated. You can use all features without making a purchase."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu apoyo ayuda a mantener la app actualizada. Puedes usar todas las funciones sin realizar una compra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre soutien aide à maintenir l’app à jour. Vous pouvez utiliser toutes les fonctionnalités sans effectuer d’achat."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "応援していただくことで、アプリの更新を継続できます。購入しなくてもすべての機能を利用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여러분의 지원은 앱을 계속 업데이트하는 데 도움이 됩니다. 구매하지 않아도 모든 기능을 사용할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu apoio ajuda a manter o app atualizado. Você pode usar todos os recursos sem fazer uma compra."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的支持有助于保持应用更新。无需购买也可以使用所有功能。"
          }
        }
      }
    },
