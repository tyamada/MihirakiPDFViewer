            "value": "Ajusta el grado de nitidez del texto y las líneas."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Ina-adjust kung gaano katindi ang pagpapatalas sa teksto at mga linya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Règle l’intensité d’accentuation de la netteté du texte et des lignes."
          }
        },
        "id": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Menyesuaikan tingkat penajaman teks dan garis."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "文字や線を鮮明にする強さを調整します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "텍스트와 선을 선명하게 처리하는 강도를 조절합니다."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "पाठ र रेखाहरूको तीक्ष्णता कति बढाउने भन्ने समायोजन गर्छ।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Ajusta a intensidade da nitidez do texto e das linhas."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Điều chỉnh mức độ làm sắc nét của văn bản và đường nét."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "调整文字和线条的锐化强度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "調整文字和線條的銳化強度。"
          }
        }
      }
    },
    "help_setting_single_page_in_portrait_description": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Zeigt im Hochformat jeweils eine Seite an, auch in breiten iPad-Layouts. Deaktiviere diese Option, um die gewählte Doppelseiteneinstellung auch im Hochformat beizubehalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Displays one page at a time in portrait-shaped reading areas, including wide iPad layouts. Turn this option off to keep the selected two-page setting in portrait."
          }
        },
        "es": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Muestra una página a la vez en áreas de lectura verticales, incluso en diseños amplios de iPad. Desactiva esta opción para mantener el ajuste de dos páginas seleccionado en vertical."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Nagpapakita ng tig-isang pahina sa patayong lugar ng pagbabasa, kasama ang malalapad na layout ng iPad. I-off ang opsyong ito para mapanatili ang napiling setting para sa dalawang pahina sa patayong layout."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Affiche une page à la fois dans les zones de lecture en orientation portrait, y compris dans les dispositions larges sur iPad. Désactivez cette option pour conserver le réglage double page choisi en orientation portrait."
          }
        },
        "id": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Menampilkan satu halaman setiap kali di area baca berorientasi potret, termasuk pada tata letak iPad yang lebar. Nonaktifkan opsi ini agar pengaturan dua halaman yang dipilih tetap berlaku dalam orientasi potret."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "縦長の閲覧領域では、iPadの幅広いレイアウトでも1ページずつ表示します。縦長でも選択した見開き設定を維持するには、この設定をオフにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "세로형 읽기 영역에서는 iPad의 넓은 레이아웃에서도 한 페이지씩 표시합니다. 세로형 영역에서 선택한 두 페이지 설정을 유지하려면 이 옵션을 끄세요."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "iPad का फराकिला लेआउटमा समेत ठाडो पढ्ने क्षेत्रमा एक पटकमा एउटा पृष्ठ देखाउँछ। ठाडो क्षेत्रमा छानिएको दुई-पृष्ठ सेटिङ कायम राख्न यो विकल्प बन्द गर्नुहोस्।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Exibe uma página por vez em áreas de leitura na vertical, inclusive em layouts amplos do iPad. Desative esta opção para manter a configuração de duas páginas selecionada na vertical."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Hiển thị từng trang trong vùng đọc theo chiều dọc, kể cả trên bố cục rộng của iPad. Tắt tùy chọn này để giữ cài đặt hai trang đã chọn khi đọc theo chiều dọc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "在纵向阅读区域中每次显示一页，较宽的 iPad 布局也适用。关闭此选项可在纵向阅读区域中保留所选的双页设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "在直向閱讀區域中每次顯示一頁，較寬的 iPad 版面配置也適用。關閉此選項即可在直向閱讀區域中保留所選的雙頁設定。"
          }
        }
      }
    },
    "help_setting_spread_view_description": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Zeigt zwei Seiten nebeneinander an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Displays two pages side by side."
          }
        },
        "es": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Muestra dos páginas una junto a otra."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Ipinapakita nang magkatabi ang dalawang pahina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Affiche deux pages côte à côte."
          }
        },
        "id": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Menampilkan dua halaman secara berdampingan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "2ページを横に並べて表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "두 페이지를 나란히 표시합니다."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "दुई पृष्ठलाई छेउछाउमा देखाउँछ।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Exibe duas páginas lado a lado."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Hiển thị hai trang cạnh nhau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "并排显示两页。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "並排顯示兩頁。"
          }
        }
      }
    },
    "help_setting_supporter_icons_description": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Bronze-, Silver- und Goldsymbole sind optionale Käufe. Berechtigte Codes und bereits getätigte Käufe können unter „Support“ eingelöst bzw. wiederhergestellt werden. Koyomi wird auf diesem Gerät bis zum 31. Dezember 2027 JST kostenlos bereitgestellt, auch für bestehende Nutzer. Die Bereitstellung wird lokal gespeichert und bleibt nach Ablauf der Frist bestehen. Dafür sind weder ein Kauf noch eine Kontenabfrage erforderlich. „Käufe wiederherstellen“ stellt bestehende StoreKit-Berechtigungen wieder her, kann aber eine nach Ablauf der Frist verlorene lokale kostenlose Bereitstellung nicht wiederherstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Bronze, Silver, and Gold icons are optional purchases. Eligible codes and existing purchases can be redeemed or restored in Support. Koyomi is granted free on this device through December 31, 2027 JST, including for existing users. The grant is saved locally and remains after the deadline. It requires no purchase or account lookup. Restore Purchases restores existing StoreKit rights, but cannot restore a lost local free grant after the deadline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Los iconos de Bronze, Silver y Gold son compras opcionales. Los códigos válidos y las compras existentes se pueden canjear o restaurar en Soporte. Koyomi se ofrece gratis en este dispositivo hasta el 31 de diciembre de 2027 JST, también para los usuarios existentes. La concesión se guarda localmente y permanece después de la fecha límite. No requiere ninguna compra ni consulta de cuenta. «Restaurar compras» restaura los derechos existentes de StoreKit, pero no puede recuperar una concesión local gratuita que se haya perdido después de la fecha límite."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Opsyonal na pagbili ang mga icon ng Bronze, Silver, at Gold. Maaaring i-redeem o i-restore sa Support ang mga kwalipikadong code at mga dati nang pagbili. Libreng ibinibigay ang Koyomi sa device na ito hanggang Disyembre 31, 2027 JST, kabilang ang para sa mga dati nang user. Lokal na sine-save ang grant at mananatili ito pagkatapos ng deadline. Hindi ito nangangailangan ng pagbili o paghahanap sa account. Ibinabalik ng Restore Purchases ang mga dati nang karapatan sa StoreKit, pero hindi nito maibabalik ang nawalang lokal na libreng grant pagkatapos ng deadline."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Les icônes Bronze, Silver et Gold sont des achats facultatifs. Les codes admissibles et les achats existants peuvent être utilisés ou restaurés dans la section Assistance. Koyomi est offert gratuitement sur cet appareil jusqu’au 31 décembre 2027 JST, y compris aux utilisateurs existants. L’octroi est enregistré localement et reste disponible après la date limite. Il ne nécessite ni achat ni recherche de compte. « Restaurer les achats » rétablit les droits StoreKit existants, mais ne peut pas récupérer un octroi local gratuit perdu après la date limite."
          }
        },
        "id": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Ikon Bronze, Silver, dan Gold adalah pembelian opsional. Kode yang memenuhi syarat dan pembelian yang sudah ada dapat ditukarkan atau dipulihkan di Dukungan. Koyomi diberikan gratis di perangkat ini hingga 31 Desember 2027 JST, termasuk bagi pengguna lama. Pemberian ini disimpan secara lokal dan tetap berlaku setelah batas waktu. Pemberian ini tidak memerlukan pembelian atau pencarian akun. Pulihkan Pembelian memulihkan hak StoreKit yang sudah ada, tetapi tidak dapat memulihkan pemberian gratis lokal yang hilang setelah batas waktu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Bronze・Silver・Goldのアイコン購入は任意です。対象コードの引換と既存の購入の復元は応援画面で行えます。こよみは既存利用者も含め、2027年12月31日（日本時間）までこの端末上で無料付与します。付与結果は端末内に保存し、期限後も保持します。購入やアカウントの照会は不要です。購入の復元は既存のStoreKit権利を復元しますが、期限後に失われた無料付与の端末内記録は復元できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Bronze, Silver, Gold 아이콘은 선택 구매 항목입니다. 자격이 있는 코드와 기존 구매 항목은 지원에서 사용하거나 복원할 수 있습니다. 기존 사용자도 포함하여 이 기기에서 Koyomi를 2027년 12월 31일 JST까지 무료로 받을 수 있습니다. 이 무료 제공 권한은 기기에 로컬로 저장되며 기한이 지난 후에도 유지됩니다. 구매나 계정 조회가 필요하지 않습니다. ‘구입 항목 복원’은 기존 StoreKit 권한을 복원하지만, 기한이 지난 후 분실한 로컬 무료 제공 권한은 복원할 수 없습니다."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Bronze, Silver र Gold आइकनहरू वैकल्पिक खरिद हुन्। योग्य कोडहरू र पहिलेका खरिदहरू Support मा प्रयोग वा पुनर्स्थापना गर्न सकिन्छ। पहिलेका प्रयोगकर्ताहरूका लागि पनि यस उपकरणमा Koyomi डिसेम्बर ३१, २०२७ JST सम्म निःशुल्क उपलब्ध गराइन्छ। यो सुविधा स्थानीय रूपमा सुरक्षित हुन्छ र म्यादपछि पनि रहन्छ। यसका लागि खरिद वा खाता खोजी आवश्यक पर्दैन। Restore Purchases ले पहिलेका StoreKit अधिकारहरू पुनर्स्थापना गर्छ, तर म्यादपछि हराएको स्थानीय निःशुल्क सुविधा पुनर्स्थापना गर्न सक्दैन।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Os ícones Bronze, Silver e Gold são compras opcionais. Códigos elegíveis e compras existentes podem ser resgatados ou restaurados em Suporte. Koyomi é disponibilizado gratuitamente neste dispositivo até 31 de dezembro de 2027 JST, inclusive para usuários existentes. A concessão é salva localmente e permanece após o prazo. Ela não exige compra nem consulta à conta. Restaurar Compras recupera os direitos existentes do StoreKit, mas não pode recuperar uma concessão local gratuita perdida após o prazo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Các biểu tượng Bronze, Silver và Gold là tùy chọn mua. Bạn có thể đổi mã đủ điều kiện và khôi phục các giao dịch mua hiện có trong mục Hỗ trợ. Koyomi được cấp miễn phí trên thiết bị này đến hết ngày 31 tháng 12 năm 2027 JST, kể cả cho người dùng hiện tại. Quyền sử dụng này được lưu cục bộ và vẫn còn sau thời hạn. Không cần mua hàng hoặc tra cứu tài khoản. Khôi phục giao dịch mua sẽ khôi phục các quyền StoreKit hiện có, nhưng không thể khôi phục quyền miễn phí cục bộ đã mất sau thời hạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Bronze、Silver 和 Gold 图标为可选购买项目。符合条件的代码和已有购买项目可在“支持”中兑换或恢复。此设备上的 Koyomi 可在 2027 年 12 月 31 日 JST 当天结束前免费获得，现有用户也适用。此授权会保存在本地，并在截止日期后继续有效。无需购买或查询账户。“恢复购买”可恢复现有的 StoreKit 权益，但无法恢复截止日期后丢失的本地免费授权。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Bronze、Silver 和 Gold 圖示為選購項目。符合資格的代碼和既有購買項目可在「支援」中兌換或還原。此裝置上的 Koyomi 可在 2027 年 12 月 31 日 JST 當天結束前免費取得，現有使用者也適用。此授權會儲存在本機，並在期限過後繼續有效。無需購買或查詢帳戶。「還原購買項目」可還原既有的 StoreKit 權益，但無法還原期限過後遺失的本機免費授權。"
          }
        }
      }
    },
    "help_settings_description": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Im Bildschirm „Einstellungen“ können die Darstellung angepasst, Dokumentinformationen geprüft, Hilfe und Diagnose aufgerufen, App-Informationen angezeigt und der Entwickler unterstützt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Use Settings to adjust viewing, review document information, access help and diagnostics, view app information, and support the developer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Usa Ajustes para configurar la visualización, consultar la información del documento, acceder a la ayuda y los diagnósticos, ver información de la app y apoyar a la persona que la desarrolla."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Gamitin ang Mga Setting para i-adjust ang pagtingin, suriin ang impormasyon ng dokumento, buksan ang tulong at diagnostics, tingnan ang impormasyon ng app, at suportahan ang developer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Utilisez Réglages pour personnaliser l’affichage, consulter les informations du document, accéder à l’aide et aux diagnostics, afficher les informations de l’app et soutenir le développeur."
          }
        },
        "id": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Gunakan Pengaturan untuk menyesuaikan tampilan, meninjau informasi dokumen, mengakses bantuan dan diagnostik, melihat informasi app, serta mendukung pengembang."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "“設定”では、表示の調整、文書情報の確認、ヘルプと診断へのアクセス、アプリ情報の表示、および開発者の応援ができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "설정에서 보기 방식을 조절하고 문서 정보를 확인하며 도움말과 진단에 접근하고 앱 정보를 본 후 개발자를 후원할 수 있습니다."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "हेर्ने तरिका समायोजन गर्न, कागजातको जानकारी जाँच गर्न, मद्दत र निदान खोल्न, एपको जानकारी हेर्न र विकासकर्तालाई सहयोग गर्न सेटिङहरू प्रयोग गर्नुहोस्।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Use Ajustes para personalizar a visualização, consultar informações do documento, acessar a ajuda e os diagnósticos, ver informações do app e apoiar a pessoa que desenvolve o app."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Sử dụng Cài đặt để điều chỉnh chế độ xem, xem lại thông tin tài liệu, truy cập trợ giúp và chẩn đoán, xem thông tin ứng dụng và ủng hộ nhà phát triển."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "使用“设置”调整阅读方式、查看文档信息、访问帮助和诊断、查看应用信息，以及支持开发者。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "使用「設定」調整顯示方式、查看文件資訊、開啟輔助說明和診斷、查看App資訊，以及支持開發者。"
          }
        }
      }
    },
