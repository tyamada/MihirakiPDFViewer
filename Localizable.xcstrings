          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Al restablecer los ajustes, se recuperará el icono predeterminado de la app. Para volver a usar un icono de colaborador, tendrás que realizar otra compra de apoyo."
