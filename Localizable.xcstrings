    "supporter_icon_purchase_description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jeder Kauf schaltet das zugehörige Unterstützer-Symbol dauerhaft frei. Käufe können auf einem anderen Gerät mit demselben Apple Account wiederhergestellt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Each purchase permanently unlocks its supporter icon. Restore purchases on another device using the same Apple Account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cada compra desbloquea permanentemente el icono de colaborador correspondiente. Restaura las compras en otro dispositivo con la misma cuenta de Apple."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Permanenteng ina-unlock ng bawat pagbili ang supporter icon nito. I-restore ang mga binili sa ibang device gamit ang parehong Apple Account."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Chaque achat déverrouille définitivement l’icône de soutien correspondante. Restaurez vos achats sur un autre appareil avec le même compte Apple."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Setiap pembelian membuka ikon pendukungnya secara permanen. Pulihkan pembelian di perangkat lain menggunakan Akun Apple yang sama."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "購入すると、対応するサポーターアイコンが永続的に解除されます。同じApple Accountを使えば、別のデバイスでも購入を復元できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "구매할 때마다 해당 후원자 아이콘이 영구적으로 잠금 해제됩니다. 동일한 Apple Account를 사용하면 다른 기기에서 구매 항목을 복원할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cada compra desbloqueia permanentemente o ícone de apoiador correspondente. Restaure as compras em outro dispositivo usando a mesma Conta Apple."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mỗi giao dịch mua sẽ mở khóa vĩnh viễn biểu tượng ủng hộ tương ứng. Khôi phục các giao dịch mua trên thiết bị khác bằng cùng một Tài khoản Apple."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "每次购买都会永久解锁对应的支持者应用图标。使用同一Apple Account可在其他设备上恢复购买项目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "每次購買都會永久解鎖對應的支持者App圖像。使用相同的Apple Account即可在其他裝置回復購買項目。"
          }
        }
      }
