        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 아이콘을 변경한 경우 재설정 후에는 되돌릴 수 없습니다!"
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "यदि तपाईंले एप आइकन परिवर्तन गर्नुभएको छ भने, रिसेट गरेपछि त्यसलाई पुनर्स्थापना गर्न सकिँदैन!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você alterou o ícone do app, ele não poderá ser restaurado após a redefinição!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nếu bạn đã thay đổi biểu tượng ứng dụng, biểu tượng đó sẽ không thể được khôi phục sau khi đặt lại!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
