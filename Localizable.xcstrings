    "reset_app_icon_warning" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Beim Zurücksetzen wird das standardmäßige App-Symbol wiederhergestellt. Um ein Unterstützer-Symbol erneut zu verwenden, muss die App erneut durch einen Kauf unterstützt werden."
          }
        },
        "en" : {
          "stringUnit" : {
