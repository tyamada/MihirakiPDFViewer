    "help_setting_single_page_in_portrait_description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zeigt jeweils eine Seite an, wenn der Bildschirm höher als breit ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Displays one page at a time when the screen is taller than it is wide."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Muestra una página cada vez cuando la pantalla es más alta que ancha."
