    "help_setting_device_testing_description": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Gerätetests zeigen Prüfungen von App, Gerät, Arbeitsspeicher, Speicherplatz und PDF an. Geteilte Ergebnisse enthalten weder den verfügbaren Speicherplatz noch dessen Einfluss auf das Gesamtergebnis. Wähle aus, an wen und ob du senden möchtest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Device tests show app, device, memory, storage, and PDF checks. Shared results exclude available storage and its effect on the overall result. Choose the recipient and whether to send."
          }
        },
        "es": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Las pruebas muestran comprobaciones de la app, el dispositivo, la memoria, el almacenamiento y PDF. Los resultados compartidos excluyen el almacenamiento disponible y su efecto en el resultado global. Elige el destinatario y si quieres enviarlos."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Ipinapakita ng mga test ng device ang mga pagsusuri sa app, device, memory, storage, at PDF. Hindi kasama sa ibinabahaging resulta ang available na storage at ang epekto nito sa pangkalahatang resulta. Piliin ang tatanggap at kung ipapadala."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Les tests affichent les vérifications de l’app, de l’appareil, de la mémoire, du stockage et des PDF. Les résultats partagés excluent le stockage disponible et son effet sur le résultat global. Choisissez le destinataire et décidez si vous souhaitez les envoyer."
          }
        },
        "id": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Pengujian perangkat menampilkan pemeriksaan app, perangkat, memori, penyimpanan, dan PDF. Hasil yang dibagikan tidak menyertakan penyimpanan yang tersedia maupun pengaruhnya pada hasil keseluruhan. Pilih penerima dan tentukan apakah akan mengirim."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "実機テストでは、アプリ、端末、メモリ、ストレージ、PDFの検査結果を表示します。共有結果には、空き容量とその検査が総合結果へ与える影響を含めません。宛先と送信するかどうかを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "기기 테스트는 앱, 기기, 메모리, 저장 공간 및 PDF 검사 결과를 표시합니다. 공유 결과에는 사용 가능한 저장 공간과 해당 검사가 종합 결과에 미치는 영향이 포함되지 않습니다. 받는 사람과 전송 여부를 선택하십시오."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "यन्त्र परीक्षणले एप, यन्त्र, मेमोरी, भण्डारण र PDF का जाँचहरू देखाउँछ। साझा परिणाममा उपलब्ध भण्डारण र समग्र परिणाममा त्यसको प्रभाव समावेश हुँदैन। प्राप्तकर्ता र पठाउने वा नपठाउने भन्ने छान्नुहोस्।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Os testes mostram verificações do app, dispositivo, memória, armazenamento e PDF. Os resultados compartilhados excluem o armazenamento disponível e seu efeito no resultado geral. Escolha o destinatário e se deseja enviar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Kiểm tra thiết bị hiển thị kết quả kiểm tra ứng dụng, thiết bị, bộ nhớ, dung lượng lưu trữ và PDF. Kết quả chia sẻ không bao gồm dung lượng lưu trữ khả dụng và ảnh hưởng của phép kiểm tra đó đến kết quả tổng thể. Hãy chọn người nhận và quyết định có gửi hay không."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "设备测试显示应用、设备、内存、存储和PDF的检查结果。分享结果不包含可用存储空间及其检查对总体结果的影响。请选择收件人并决定是否发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "裝置測試顯示App、裝置、記憶體、儲存空間和PDF的檢查結果。分享結果不包含可用儲存空間及其檢查對整體結果的影響。請選擇收件人並決定是否傳送。"
          }
        }
      }
    },
