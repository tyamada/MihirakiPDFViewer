    "Do not attach the PDF itself or include document contents, file names, names, or other personal information.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Veröffentliche keine personenbezogenen Daten, PDF-Dateien oder deren Inhalte, Dateinamen oder Screenshots in öffentlichen GitHub Issues."
          }
        },
        "en": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Do not post personal information, PDF files or their contents, file names, or screenshots in public GitHub Issues."
          }
        },
        "es": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "No publiques información personal, archivos PDF o su contenido, nombres de archivo ni capturas de pantalla en los informes públicos de GitHub Issues."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Huwag mag-post ng personal na impormasyon, mga PDF file o nilalaman ng mga ito, mga pangalan ng file, o mga screenshot sa pampublikong GitHub Issues."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Ne publiez pas d’informations personnelles, de fichiers PDF ou de leur contenu, de noms de fichiers ni de captures d’écran dans les signalements publics GitHub Issues."
          }
        },
        "id": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Jangan memposting informasi pribadi, file PDF atau isinya, nama file, atau tangkapan layar di GitHub Issues yang bersifat publik."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "公開のGitHub Issuesには、個人情報、PDFファイルやその内容、ファイル名、スクリーンショットを投稿しないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "공개 GitHub Issues에 개인정보, PDF 파일이나 그 내용, 파일 이름 또는 스크린샷을 게시하지 마세요."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "सार्वजनिक GitHub Issues मा व्यक्तिगत जानकारी, PDF फाइल वा तिनका सामग्री, फाइलका नाम वा स्क्रिनसट पोस्ट नगर्नुहोस्।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Não publique informações pessoais, arquivos PDF ou seu conteúdo, nomes de arquivos ou capturas de tela em relatos públicos no GitHub Issues."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Không đăng thông tin cá nhân, tệp PDF hoặc nội dung của chúng, tên tệp hay ảnh chụp màn hình lên GitHub Issues công khai."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "请勿在公开的 GitHub Issues 中发布个人信息、PDF 文件或其内容、文件名或截屏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "請勿在公開的GitHub Issues張貼個人資訊、PDF檔案或其內容、檔案名稱或螢幕截圖。"
          }
        }
      }
    },
