    "help_setting_app_logs_description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zeigt datenschutzkonforme Protokolle der letzten 24 Stunden. Protokolle werden automatisch gelöscht und nur geteilt, wenn du auf „Teilen“ tippst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Shows privacy-safe logs from the last 24 hours. Logs are deleted automatically and shared only when you tap Share."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Muestra registros respetuosos con la privacidad de las últimas 24 horas. Los registros se eliminan automáticamente y solo se comparten cuando tocas Compartir."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ipinapakita ang mga log na ligtas sa privacy mula sa nakaraang 24 na oras. Awtomatikong binubura ang mga log at ibinabahagi lamang kapag i-tap mo ang Ibahagi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Affiche les journaux respectueux de la confidentialité des dernières 24 heures. Ils sont supprimés automatiquement et partagés uniquement lorsque vous touchez « Partager »."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "過去24時間のプライバシーに配慮したログを表示します。ログは自動的に削除され、“共有”をタップした場合にのみ共有されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "최근 24시간 동안의 개인정보 보호를 고려한 로그를 표시합니다. 로그는 자동으로 삭제되며 사용자가 ‘공유’를 탭한 경우에만 공유됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mostra registros sem dados pessoais das últimas 24 horas. Os registros são apagados automaticamente e compartilhados somente quando você toca em Compartilhar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hiển thị nhật ký được thiết kế để bảo vệ quyền riêng tư trong 24 giờ qua. Nhật ký được tự động xóa và chỉ được chia sẻ khi bạn chạm vào Chia sẻ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "显示过去24小时内不含隐私信息的日志。日志会自动删除，并且仅在你轻点“共享”时共享。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "顯示過去24小時內符合隱私保護的記錄。記錄會自動刪除，且只有在你點一下「分享」時才會分享。"
          }
        }
      }
    },
