    },
    "help_settings_description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Im Bildschirm „Einstellungen“ können die Darstellung angepasst, Dokumentinformationen geprüft, Hilfe und Diagnose aufgerufen, App-Informationen angezeigt und der Entwickler unterstützt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Use Settings to adjust viewing, review document information, access help and diagnostics, view app information, and support the developer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Usa Ajustes para configurar la visualización, consultar la información del documento, acceder a la ayuda y los diagnósticos, ver información de la app y apoyar a la persona que la desarrolla."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gamitin ang Mga Setting para i-adjust ang pagtingin, suriin ang impormasyon ng dokumento, buksan ang tulong at diagnostics, tingnan ang impormasyon ng app, at suportahan ang developer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Utilisez Réglages pour personnaliser l’affichage, consulter les informations du document, accéder à l’aide et aux diagnostics, afficher les informations de l’app et soutenir le développeur."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gunakan layar Pengaturan untuk menyesuaikan tampilan dan memeriksa informasi tentang dokumen saat ini dan app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“設定”では、表示の調整、文書情報の確認、ヘルプと診断へのアクセス、アプリ情報の表示、および開発者の応援ができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "설정에서 보기 방식을 조절하고 문서 정보를 확인하며 도움말과 진단에 접근하고 앱 정보를 본 후 개발자를 후원할 수 있습니다."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "हेर्ने तरिका अनुकूलित गर्न र हालको कागजात तथा एपबारे जानकारी जाँच गर्न सेटिङहरू स्क्रिन प्रयोग गर्नुहोस्।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Use Ajustes para personalizar a visualização, consultar informações do documento, acessar a ajuda e os diagnósticos, ver informações do app e apoiar a pessoa que desenvolve o app."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sử dụng Cài đặt để điều chỉnh chế độ xem, xem lại thông tin tài liệu, truy cập trợ giúp và chẩn đoán, xem thông tin ứng dụng và ủng hộ nhà phát triển."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "使用“设置”调整阅读方式、查看文档信息、访问帮助和诊断、查看应用信息，以及支持开发者。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "使用「設定」調整顯示方式、查看文件資訊、開啟輔助說明和診斷、查看App資訊，以及支持開發者。"
          }
        }
      }
    },
