    "reset_settings_and_icon_message": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Dadurch werden die Darstellungseinstellungen zurückgesetzt, das standardmäßige App-Symbol wiederhergestellt und das aktuelle Dokument geschlossen. Gekaufte Unterstützer-Symbole bleiben verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "This resets viewing settings, restores the default app icon, and closes the current document. Purchased supporter icons remain available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Esto restablece los ajustes de visualización, restaura el icono predeterminado de la app y cierra el documento actual. Los iconos de colaborador comprados seguirán disponibles."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Ire-reset nito ang mga setting sa pagtingin, ibabalik ang default na icon ng app, at isasara ang kasalukuyang dokumento. Magagamit pa rin ang mga biniling supporter icon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Cela réinitialisera les réglages d’affichage, rétablira l’icône d’app par défaut et fermera le document actuel. Les icônes de soutien achetées resteront disponibles."
          }
        },
        "id": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Tindakan ini akan mengatur ulang pengaturan tampilan, mengembalikan ikon app default, serta menutup dokumen saat ini. Ikon pendukung yang telah dibeli tetap tersedia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "表示設定をリセットし、アプリアイコンを標準に戻して、現在のドキュメントを閉じます。購入済みのサポーターアイコンは引き続き使用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "보기 설정을 재설정하고 기본 앱 아이콘으로 복원한 다음 현재 문서를 닫습니다. 구매한 후원자 아이콘은 계속 사용할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Isso redefinirá os ajustes de visualização, restaurará o ícone padrão do app e fechará o documento atual. Os ícones de apoiador comprados continuarão disponíveis."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Thao tác này sẽ đặt lại cài đặt hiển thị, khôi phục biểu tượng ứng dụng mặc định và đóng tài liệu hiện tại. Các biểu tượng ủng hộ đã mua vẫn có thể sử dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "这将重置查看设置、恢复默认应用图标并关闭当前文档。已购买的支持者应用图标仍可使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "此操作會重設顯示設定、恢復預設App圖像，並關閉目前的文件。已購買的支持者App圖像仍可使用。"
          }
        }
      }
    },
