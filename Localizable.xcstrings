    "alternate_app_icons_not_supported": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternative App-Symbole werden in dieser Umgebung nicht unterstützt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternate app icons are not supported in this environment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los iconos alternativos de la app no son compatibles en este entorno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les icônes alternatives de l’app ne sont pas prises en charge dans cet environnement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この環境では代替アプリアイコンはサポートされていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 환경에서는 대체 앱 아이콘이 지원되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ícones alternativos do app não são compatíveis neste ambiente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此环境不支持备用应用图标。"
          }
        }
      }
    },
