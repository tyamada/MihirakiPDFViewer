    "help_setting_app_info_description": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Zeigt App-Version, Build-Nummer, Lizenz, Unterstützerabzeichen und Supportoptionen an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Shows the app version, build number, license, supporter badges, and support options."
          }
        },
        "es": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Muestra la versión de la app, el número de compilación, la licencia, las insignias de colaborador y las opciones de apoyo."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Ipinapakita ang bersyon ng app, build number, lisensya, mga supporter badge, at mga opsyon sa pagsuporta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Affiche la version de l’app, le numéro de build, la licence, les badges de soutien et les options de soutien."
          }
        },
        "id": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Menampilkan versi app, nomor build, lisensi, lencana pendukung, dan opsi dukungan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "アプリのバージョン、ビルド番号、ライセンス、サポーターバッジ、および応援方法を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "앱 버전, 빌드 번호, 라이선스, 후원자 배지 및 후원 옵션을 표시합니다."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "एपको संस्करण, बिल्ड नम्बर, इजाजतपत्र, समर्थक ब्याजहरू र सहयोगका विकल्पहरू देखाउँछ।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Mostra a versão do app, o número da compilação, a licença, os selos de apoiador e as opções de apoio."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Hiển thị phiên bản ứng dụng, số bản dựng, giấy phép, huy hiệu người ủng hộ và các tùy chọn ủng hộ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "显示应用版本、构建号、许可证、支持者徽章和支持选项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "顯示App版本、建置編號、授權、支持者徽章和支持選項。"
          }
        }
      }
    },
    "help_setting_app_logs_description": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Zeigt bis zu 2 000 Einträge der letzten 24 Stunden an, die beim Lesen oder Aufzeichnen bereinigt werden. Geteilte Protokolle enthalten App- und Betriebssystemversionen, Ereignistypen, Zeitstempel, Anzahlen und Zeitdauern. Wähle aus, an wen und ob du senden möchtest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Shows up to 2,000 entries from the last 24 hours, trimmed when read or recorded. Shared logs contain app and OS versions, event types, timestamps, counts, and durations. Choose the recipient and whether to send."
          }
        },
        "es": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Muestra hasta 2000 entradas de las últimas 24 horas, depuradas al leerlas o registrarlas. Los registros compartidos contienen versiones de la app y del sistema operativo, tipos de eventos, fechas y horas, cantidades y duraciones. Elige el destinatario y si quieres enviarlos."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Nagpapakita ng hanggang 2,000 entry mula sa nakaraang 24 na oras, na nililimitahan kapag binabasa o itinatala. Kasama sa mga ibinabahaging log ang bersyon ng app at OS, mga uri ng event, timestamp, bilang, at tagal. Piliin ang tatanggap at kung ipapadala."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Affiche jusqu’à 2 000 entrées des dernières 24 heures, limitées lors de la lecture ou de l’enregistrement. Les journaux partagés contiennent les versions de l’app et du système, les types d’événements, les horodatages, les nombres et les durées. Choisissez le destinataire et décidez si vous souhaitez les envoyer."
          }
        },
        "id": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Menampilkan hingga 2.000 entri dari 24 jam terakhir, yang dibatasi saat dibaca atau dicatat. Log yang dibagikan berisi versi app dan OS, jenis peristiwa, cap waktu, jumlah, dan durasi. Pilih penerima dan tentukan apakah akan mengirim."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "過去24時間の記録を最大2,000件表示し、読込時と記録時に整理します。共有ログには、アプリとOSの版、イベント種別、日時、件数、処理時間を含みます。宛先と送信するかどうかを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "최근 24시간의 기록을 최대 2,000개 표시하며 읽거나 기록할 때 정리합니다. 공유 로그에는 앱 및 OS 버전, 이벤트 유형, 타임스탬프, 개수 및 처리 시간이 포함됩니다. 받는 사람과 전송 여부를 선택하십시오."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "पछिल्लो 24 घण्टाका बढीमा 2,000 प्रविष्टि देखाउँछ र पढ्दा वा लेख्दा सीमा अनुसार हटाउँछ। साझा लगमा एप र OS का संस्करण, घटनाका प्रकार, समय विवरण, सङ्ख्या र अवधि समावेश हुन्छन्। प्राप्तकर्ता र पठाउने वा नपठाउने भन्ने छान्नुहोस्।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Mostra até 2.000 registros das últimas 24 horas, limitados ao ler ou registrar. Os registros compartilhados contêm versões do app e do sistema operacional, tipos de eventos, datas e horas, contagens e durações. Escolha o destinatário e se deseja enviar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Hiển thị tối đa 2.000 mục trong 24 giờ qua, được giới hạn khi đọc hoặc ghi. Nhật ký chia sẻ chứa phiên bản ứng dụng và hệ điều hành, loại sự kiện, dấu thời gian, số lượng và thời lượng. Hãy chọn người nhận và quyết định có gửi hay không."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "显示过去24小时内最多2,000条记录，并在读取或记录时清理超出限制的记录。分享的日志包含应用和操作系统版本、事件类型、时间戳、计数和时长。请选择收件人并决定是否发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "顯示過去24小時內最多2,000筆記錄，並在讀取或記錄時清理超出限制的記錄。分享的記錄包含App和作業系統版本、事件類型、時間戳記、計數和時間長度。請選擇收件人並決定是否傳送。"
          }
        }
      }
    },
    "help_setting_cover_page_description": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Zeigt die erste Seite in der Zweiseitenansicht separat als Titelseite an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Displays the first page separately as the cover in spread view."
          }
        },
        "es": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Muestra la primera página por separado como portada en la vista de dos páginas."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Ipinapakita nang hiwalay ang unang pahina bilang pabalat sa view na dalawang pahina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Affiche la première page séparément comme couverture dans la vue en deux pages."
          }
        },
