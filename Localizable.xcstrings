    "All tests passed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Alle Tests wurden bestanden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Todas las pruebas se han superado."
          }
        },
        "fil": {
