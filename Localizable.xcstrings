    "If you encounter a problem, please collect the information below and submit a report on GitHub Issues.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Beschreibe das Problem zuerst schriftlich: Fasse es kurz zusammen, nenne die Schritte zum Reproduzieren und beschreibe das erwartete und das tatsächliche Verhalten. Dein echter Name ist nicht erforderlich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Start with a written description: summarize the problem, give the steps to reproduce it, and explain what you expected and what actually happened. Your real name is not required."
          }
        },
        "es": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Empieza con una descripción por escrito: resume el problema, indica los pasos para reproducirlo y explica el comportamiento esperado y lo que ha ocurrido realmente. No es necesario indicar tu nombre real."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Unahin ang nakasulat na paliwanag: ibuod ang problema, ilahad ang mga hakbang para maulit ito, at ipaliwanag ang inaasahan mo at ang aktuwal na nangyari. Hindi kailangan ang tunay mong pangalan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Commencez par une description écrite : résumez le problème, indiquez les étapes pour le reproduire et expliquez le comportement attendu et le comportement observé. Votre nom réel n’est pas nécessaire."
          }
        },
        "id": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Mulailah dengan penjelasan tertulis: rangkum masalahnya, jelaskan langkah untuk mengulanginya, serta jelaskan hasil yang diharapkan dan yang sebenarnya terjadi. Nama asli Anda tidak diperlukan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "まず文章で、問題の概要、再現手順、期待した動作と実際の動作を説明してください。実名の記入は不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "먼저 글로 설명해 주세요. 문제의 개요, 재현 단계, 기대한 동작과 실제로 일어난 일을 적어 주세요. 실명은 필요하지 않습니다."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "पहिले लिखित विवरण दिनुहोस्: समस्याको सार, समस्या दोहोर्‍याउने चरणहरू, अपेक्षा गरिएको व्यवहार र वास्तवमा के भयो भन्ने कुरा लेख्नुहोस्। आफ्नो वास्तविक नाम दिनु पर्दैन।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Comece com uma descrição por escrito: resuma o problema, informe as etapas para reproduzi-lo e explique o que você esperava e o que realmente aconteceu. Não é necessário informar seu nome real."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "Hãy bắt đầu bằng mô tả bằng văn bản: tóm tắt vấn đề, nêu các bước tái hiện, đồng thời giải thích kết quả bạn mong đợi và điều thực tế đã xảy ra. Bạn không cần cung cấp tên thật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "请先用文字说明：概述问题、列出重现步骤，并说明预期行为和实际发生的情况。无需填写真实姓名。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "machine_translated",
            "value": "請先用文字說明：概述問題、列出重現步驟，並說明預期行為和實際發生的情況。不必填寫真實姓名。"
          }
        }
      }
    },
