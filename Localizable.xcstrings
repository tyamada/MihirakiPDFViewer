{
  "sourceLanguage": "en",
  "strings": {
    "supporter_badge_description": {
      "comment": "Description for Bronze, Silver and Gold supporter badge detail sheets. Koyomi uses its separate free commemorative description.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A badge recognizing your support for this app’s development."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリの開発をご支援いただいたことを示すバッジです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱의 개발을 지원해 주신 데 대한 감사의 배지입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这枚徽章是为了感谢你对这款应用开发的支持。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這枚徽章是為了感謝你對這款 App 開發的支持。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Abzeichen als Anerkennung für deine Unterstützung bei der Entwicklung dieser App."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un badge en reconnaissance de votre soutien au développement de cette application."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una insignia en reconocimiento a tu apoyo al desarrollo de esta aplicación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um distintivo em reconhecimento ao seu apoio ao desenvolvimento deste app."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Huy hiệu ghi nhận sự hỗ trợ của bạn đối với việc phát triển ứng dụng này."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Isang badge bilang pagkilala sa suporta mo sa pagbuo ng app na ito."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो एपको विकासमा तपाईंले गर्नुभएको सहयोगको कदरस्वरूप दिइने ब्याज।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lencana sebagai penghargaan atas dukungan Anda terhadap pengembangan aplikasi ini."
          }
        }
      }
    },
    "": {
      "shouldTranslate": false
    },
