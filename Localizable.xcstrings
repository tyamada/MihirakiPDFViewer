    "A GitHub account is required. The information you submit may be publicly visible." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ein GitHub-Account ist erforderlich. Die übermittelten Informationen sind möglicherweise öffentlich sichtbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se requiere una cuenta de GitHub. La información que envíes puede ser visible públicamente."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kailangan ng GitHub account. Maaaring makita ng publiko ang impormasyong isusumite mo."
          }
        },
        "fr" : {
          "stringUnit" : {
