        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jika Anda telah mengubah ikon app, ikon tersebut tidak dapat dipulihkan setelah pengaturan diatur ulang!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリアイコンを変更している場合、リセット後に元に戻すことはできません！"
