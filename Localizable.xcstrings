    "reset_app_icon_warning" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du das App-Symbol geändert hast, kann es nach dem Zurücksetzen nicht wiederhergestellt werden!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you have changed the app icon, it cannot be restored after reset!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si has cambiado el icono de la app, no se podrá restaurar después del restablecimiento."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kung binago mo ang icon ng app, hindi na ito maibabalik pagkatapos mag-reset!"
