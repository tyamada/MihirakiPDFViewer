# Xcode
#
# gitignore contributors: remember to update Global/Xcode.gitignore, Objective-C.gitignore & Swift.gitignore

## User settings
xcuserdata/

## Obj-C/Swift specific
*.hmap

## App packaging
*.ipa
*.dSYM.zip
*.dSYM

## Playgrounds
timeline.xctimeline
playground.xcworkspace

# Swift Package Manager
#
# Add this line if you want to avoid checking in source code from Swift Package Manager dependencies.
# Packages/
# Package.pins
# Package.resolved
# *.xcodeproj
#
# Xcode automatically generates this directory with a .xcworkspacedata file and xcuserdata
# hence it is not needed unless you have added a package configuration file to your project
# .swiftpm

.build/

# CocoaPods
#
# We recommend against adding the Pods directory to your .gitignore. However
# you should judge for yourself, the pros and cons are mentioned at:
# https://guides.cocoapods.org/using/using-cocoapods.html#should-i-check-the-pods-directory-into-source-control
#
# Pods/
#
# Add this line if you want to avoid checking in source code from the Xcode workspace
# *.xcworkspace

# Carthage
#
# Add this line if you want to avoid checking in source code from Carthage dependencies.
# Carthage/Checkouts

Carthage/Build/

# fastlane
#
# It is recommended to not store the screenshots in the git repo.
# Instead, use fastlane to re-generate the screenshots whenever they are needed.
# For more information about the recommended setup visit:
# https://docs.fastlane.tools/best-practices/source-control/#source-control

fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# Working Folder
AppStoreConnect/
output/
/build/
/tmp/
convpng.py

# Keep app asset catalogs trackable even when a global Assets.* rule is present.
!MihirakiPDFViewer/Assets.xcassets/
!MihirakiPDFViewer/Assets.xcassets/**

# Required build input, even when a global ignore excludes Info.plist.
!MihirakiPDFViewer/Info.plist

# Local build/test products and Python intermediates
*DerivedData/
*.xcresult/
*.xcarchive/
.artifacts/
__pycache__/
*.py[cod]
.DS_Store

# Local signing / API credentials
*.p8
*.p12
*.key
.env
.env.*
!.env.example
client_secret*.json
service-account*.json
credentials.json
token.json

# Private working evidence and generated device builds (keep files locally)
/planning/
/R/
*.app/
*.mobileprovision
module-cache/
ModuleCache.noindex/
# Internal drafts; publish reviewed summaries under release-notes instead.
/APP-NAME-ROLLOUT-ja.md
/CONNECT-FUTURE-SETUP-ja.md
/MANUAL-RELEASE-CHECKS-ja.md
/PRIVACY-REVIEW-20261024-ja.md
/RELEASE-PREPARATION-ja.md

# Shared project workspace input, without per-user state
!MihirakiPDFViewer.xcodeproj/project.xcworkspace/
!MihirakiPDFViewer.xcodeproj/project.xcworkspace/contents.xcworkspacedata

# Keep video production and export files outside public Git.
*.mp4
*.mov
*.m4v

# Required project inputs despite machine-wide project/workspace exclusions
!MihirakiPDFViewer.xcodeproj/
!MihirakiPDFViewer.xcodeproj/project.pbxproj
!MihirakiPDFViewer.xcodeproj/xcshareddata/
!MihirakiPDFViewer.xcodeproj/xcshareddata/xcschemes/
!MihirakiPDFViewer.xcodeproj/xcshareddata/xcschemes/*.xcscheme
!MihirakiPDFViewer.xcodeproj/project.xcworkspace/
!MihirakiPDFViewer.xcodeproj/project.xcworkspace/contents.xcworkspacedata

# Track only required synthetic regression fixtures, even with a global TestData rule.
!/testdata/
/testdata/*
!/testdata/Regression8_*.pdf
!/testdata/Regression8-fixtures.json
